# Copy to .env and fill in. Never commit .env.
# Auth uses Application Default Credentials: run `gcloud auth application-default login`.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# gemini-3.8-flash is served only on the "global" location (us-central1 returns 404); gemini-2.5-pro works there too.
GOOGLE_CLOUD_LOCATION=global

# Model for extraction/annotation, company profile, matching and pitch generation.
GEMINI_MODEL=gemini-3.8-flash
# Model for the independent audit (may be stronger). Defaults to GEMINI_MODEL if empty.
GEMINI_AUDIT_MODEL=gemini-3.8-flash
# Model for the company profile (one call). Defaults to gemini-3.8-flash if empty.
COMPANY_PROFILE_MODEL=gemini-3.8-flash

# Web search for the company profile (Tavily). Leave empty to use model knowledge only
# (such facts are shown as "Assumption"; only quote-checked web facts are shown as "Web-sourced").
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
