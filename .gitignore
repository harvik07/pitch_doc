# Evidence / coverage-matrix cache: ignored, except the 4 bundled brochures, which are committed
# so the standalone audit and a fresh clone work without re-running Docling.
# Keyed by the brochure's SHA-256: <sha>.json (evidence) and matrix_<sha>_<SI>.json (coverage matrix).
data/cache/*
